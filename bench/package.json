{
	"name": "@rainbowindex/bench",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Reproducible cross-engine benchmark harness for rainbowindex, Tailwind CSS v4 and UnoCSS",
	"scripts": {
		"bench": "node src/run.mjs",
		"bench:fixtures": "node src/fixtures.mjs",
		"bench:cli": "node src/cli-bench.mjs",
		"bench:parity": "node src/parity.mjs"
	},
	"engines": {
		"node": ">=20.19"
	},
	"dependencies": {
		"@tailwindcss/cli": "4.3.3",
		"@tailwindcss/node": "4.3.3",
		"@tailwindcss/oxide": "4.3.3",
		"@unocss/cli": "66.8.1",
		"@unocss/core": "66.8.1",
		"@unocss/preset-wind4": "66.8.1",
		"lightningcss": "^1.25.0",
		"rainbowindex": "workspace:*",
		"tailwindcss": "4.3.3",
		"tinybench": "6.1.4",
		"unocss": "66.8.1"
	}
