{
	"name": "rainbowindex",
	"version": "0.7.0",
	"description": "CSS-first system for building and maintaining consistent user interfaces",
	"keywords": [
		"css",
		"utility-css",
		"atomic-css",
		"design-tokens",
		"design-system",
		"theming",
		"dark-mode",
		"oklch",
		"fluid-typography",
		"google-fonts",
		"postcss",
		"postcss-plugin",
		"vite-plugin",
		"vite-plus",
		"oxlint",
		"class-merge",
		"classnames",
		"tailwind",
		"tailwindcss",
		"cli"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rainbowindex/rainbowindex.git"
	},
	"author": "rainbowindex (https://github.com/rainbowindex)",
	"homepage": "https://rainbowindex.dev",
	"bugs": "https://github.com/rainbowindex/rainbowindex/issues",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"style": "./dist/index.css",
	"scripts": {
		"build": "tsup",
		"prepare": "pnpm build",
		"prepublishOnly": "pnpm check",
		"check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:artifacts",
		"test": "vitest run --exclude __tests__/cli/** --exclude __tests__/package.test.ts",
		"test:coverage": "vitest run --coverage --exclude __tests__/cli/** --exclude __tests__/package.test.ts",
		"test:artifacts": "pnpm build && vitest run __tests__/cli/cli.test.ts __tests__/package.test.ts",
		"test:golden:update": "vitest run __tests__/golden -u",
		"test:watch": "vitest",
		"bench": "pnpm --filter @rainbowindex/bench run bench",
		"bench:cli": "pnpm --filter @rainbowindex/bench run bench:cli",
		"bench:parity": "pnpm --filter @rainbowindex/bench run bench:parity",
		"examples:build": "pnpm --filter \"@rainbowindex-example/*\" run build",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"style": "./dist/index.css",
			"browser": "./dist/browser.mjs",
			"node": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./index.css": "./dist/index.css",
		"./tailwind.css": "./dist/tailwind.css",
		"./editor": {
			"types": "./dist/editor.d.ts",
			"default": "./dist/editor.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.mjs"
		},
		"./oxlint": {
			"types": "./dist/oxlint.d.ts",
			"default": "./dist/oxlint.mjs"
		},
		"./eslint": {
			"types": "./dist/eslint.d.ts",
			"default": "./dist/eslint.mjs"
		},
		"./recipe": {
			"types": "./dist/recipe.d.ts",
			"default": "./dist/recipe.mjs"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"rainbowindex": "dist/cli.mjs"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"NOTICE.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"engines": {
		"node": ">=20.19"
	},
	"license": "MIT",
	"dependencies": {
		"chokidar": "^4.0.3",
		"lightningcss": "^1.25.0",
		"tinyglobby": "^0.2.15"
	},
	"peerDependencies": {
		"postcss": "^8.5.0",
		"vite": "*"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@capsizecss/metrics": "^4.2.0",
		"@types/node": "^25.9.1",
		"@vitest/coverage-v8": "^4.1.0",
		"esbuild": "^0.27.7",
		"eslint": "^10.9.1",
		"oxfmt": "^0.65.0",
		"postcss": "^8.5.8",
		"prettier": "^3.9.6",
		"stylelint": "^17.14.1",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vite": "8.0.0",
		"vitest": "^4.0.17",
		"vscode-css-languageservice": "^6.3.10",
		"vscode-languageserver-textdocument": "^1.0.14"
	}
}
