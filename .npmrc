# rainbowindex is published to two registries:
#   - npmjs.com, unscoped, as `rainbowindex` (the default registry)
#   - GitHub Packages, as `@rainbowindex/rainbowindex` — that registry only
#     accepts packages scoped to the repository owner
#
# This maps the @rainbowindex scope at GitHub Packages so `npm publish` and
# `npm install` resolve it there. Both reading and publishing require a token;
# CI supplies one via NODE_AUTH_TOKEN, locally put a personal access token
# (classic) with `read:packages` / `write:packages` in your ~/.npmrc:
#
#   //npm.pkg.github.com/:_authToken=YOUR_TOKEN
@rainbowindex:registry=https://npm.pkg.github.com
